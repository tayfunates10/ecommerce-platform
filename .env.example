# PostgreSQL connection used by Prisma runtime and migrations.
# Use a pooled URL in serverless production where applicable.
# This localhost value is development/example-only and is never valid production evidence.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# Required production origin for canonical URLs, hreflang, sitemap and robots metadata.
# Replace this placeholder with the real HTTPS production origin before the immutable build.
# example.com values are intentionally rejected by the production verifier.
NEXT_PUBLIC_SITE_URL="https://shop.example.com"

# Required for production certification. Set this BEFORE the immutable production build
# to the exact 40-character Git commit SHA being deployed. The build exposes it as
# X-Release-SHA and the production verifier requires an exact response-header match.
RELEASE_SHA="<40-character-git-commit-sha>"

# Optional: set this only when a real same-origin Web Vitals receiver has been
# implemented and deployed. Leave unset to disable the reporting client.
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
