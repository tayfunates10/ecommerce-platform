# PostgreSQL connection used by Prisma runtime and migrations.
# Use a pooled URL in serverless production where applicable.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ecommerce?schema=public"

# Required production origin for canonical URLs, hreflang, sitemap and robots metadata.
NEXT_PUBLIC_SITE_URL="https://shop.example.com"

# Optional: set this only when a real same-origin Web Vitals receiver has been
# implemented and deployed. Leave unset to disable the reporting client.
# NEXT_PUBLIC_WEB_VITALS_ENDPOINT=
